{
  "name": "omega-eth-intelligence",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node --test tests/browser.test.cjs",
    "test:bundle": "node scripts/check-web-bundle.mjs",
    "build:bot": "tsc --project tsconfig.runner.json && vite build --config vite.runner.config.ts",
    "bot": "npm run build:bot && node runner-dist/server.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck:bot": "tsc --project tsconfig.runner.json",
    "start:bot": "node runner-dist/server.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test:service": "npm run build:bot && node scripts/check-runner.mjs",
    "check": "npm run check:docs && npm run check:structure && npm test && npm run test:browser && npm run build && npm run test:bundle && npm run test:service",
    "check:structure": "node scripts/check-structure.mjs"
  },
  "dependencies": {
    "@metamask/connect-evm": "2.1.1",
    "@nktkas/hyperliquid": "0.33.3",
    "lightweight-charts": "5.2.1",
    "qr-code-styling": "1.9.2",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.6",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
