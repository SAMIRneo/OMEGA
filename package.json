{
  "name": "omega-eth-intelligence",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node --test tests/browser.test.cjs",
    "build:bot": "tsc --project tsconfig.runner.json && vite build --config vite.runner.config.ts",
    "bot": "npm run build:bot && node runner-dist/server.mjs"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "0.33.3",
    "lightweight-charts": "5.2.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "happy-dom": "21.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
